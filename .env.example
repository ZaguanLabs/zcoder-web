# Generate the complete line with: npm run auth:hash
APP_USERNAME=operator
APP_PASSWORD_HASH=\$argon2id\$v=19\$m=65536,t=3,p=1\$replace_with_generated_hash

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace_with_at_least_32_random_characters

# Required in production. Must be the exact public origin, with no trailing slash.
APP_ORIGIN=https://zcoder.example.net

# Only enable when every request passes through a trusted reverse proxy that overwrites these headers.
TRUST_PROXY_HEADERS=false

# Tokens and upstream URLs stay server-side and are never returned to the browser.
# Protocol 1 is cleartext: use loopback SSH tunnels or a private VPN path, never a public port.
ZCODER_SERVERS_JSON='[{"id":"workshop","name":"Workshop Mac","url":"http://127.0.0.1:7337","token":"replace-with-32+-character-token"}]'
